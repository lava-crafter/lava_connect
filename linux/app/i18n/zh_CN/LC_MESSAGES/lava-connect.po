msgstr "文字剪贴板"

msgid "Text to send"
msgstr "要发送的文字"

msgid "The device has selected this group too"
msgstr "对方也已选中此组"

msgid "The device must be paired again before it can sync."
msgstr "撤销后需要重新配对才能同步。"

msgid "The device must join and select this group"
msgstr "对方需要加入并选中此组"

msgid "Theme"
msgstr "主题"

msgid "This device · ID / fingerprint"
msgstr "本机 · ID / 指纹"

msgid "Tints buttons, selection and surfaces"
msgstr "用于按钮、选中状态和界面底色"

msgid "Trusted"
msgstr "已信任"

msgid "Unpair"
msgstr "撤销信任"

msgid "Unpair {}?"
msgstr "撤销对 {} 的信任？"

msgid "Unpair…"
msgstr "撤销信任…"

msgid "Use ↑ and ↓ to move through the list, Enter to pair."
msgstr "用 ↑ 和 ↓ 在列表中移动，按 Enter 配对。"

msgid "Version"
msgstr "版本"

msgid "Wayland sessions need wl-clipboard. Android receives in the background and sends while open, or from any app once background reading is set up."
msgstr "Wayland 会话需要安装 wl-clipboard。Android 端可在后台接收；打开应用时发送，设置后台读取后在任意应用中复制都会发送。"

