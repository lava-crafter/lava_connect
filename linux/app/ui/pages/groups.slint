import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { App, DialogKind } from "../app.slint";
import { Icons } from "../components/icons.slint";
import { Interactive, Button, ButtonKind, Switch, Chip, VDivider, HDivider } from "../components/controls.slint";
import { SectionHeader, ListRow, CopyableId, EmptyState } from "../components/surfaces.slint";

export component GroupsPage inherits HorizontalLayout {
    in property <length> list-width: 280px;

    ScrollView {
        width: root.list-width;
        VerticalLayout {
            padding: Theme.space-md;
            spacing: Theme.space-xs;
            alignment: start;
            for group in App.groups: Interactive {
                property <bool> active: group.id == App.active-group-id;
                height: Theme.row-height;
                radius: Theme.radius-lg;
                background: active ? Theme.c.secondary-container : transparent;
                accessible-label: group.name;
                accessible-item-selected: active;
                clicked => {
                    if (!active) {
                        App.group-action("select", "", group.id);
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.space-lg;
                    padding-right: Theme.space-md;
                    spacing: Theme.space-md;
                    Image {
                        source: Icons.workspaces;
                        colorize: active ? Theme.c.on-secondary-container : Theme.c.on-surface-variant;
                        width: 20px;
                        height: 20px;
                        y: (parent.height - self.height) / 2;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: group.name;
                            color: active ? Theme.c.on-secondary-container : Theme.c.on-surface;
                            font-size: Theme.title-small;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: @tr("{n} member" | "{n} members" % group.members);
                            color: Theme.c.on-surface-variant;
                            font-size: Theme.body-small;
                        }
                    }
                    if active: Chip {
                        text: @tr("Active");
                        active: true;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }
    VDivider { }
    ScrollView {
        horizontal-stretch: 1;
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-lg;
            alignment: start;
            Text {
                text: App.active-group-name;
                color: Theme.c.on-surface;
                font-size: Theme.title-large;
                font-weight: 600;
            }
            CopyableId {
                label: @tr("Group code");
                value: App.active-group-id;
                copy-label: @tr("Copy group code");
                copy(value) => { App.copy(value); }
            }
            Text {
                text: @tr("Group codes identify groups. They are not passwords and do not pair or authorize devices. Both devices must select the same group and include each other before they sync; nothing is relayed through other devices.");
                color: Theme.c.on-surface-variant;
                font-size: Theme.body-small;
                wrap: word-wrap;
            }
            VerticalLayout {
                spacing: Theme.space-xs;
                SectionHeader { text: @tr("Members"); }
                for device in App.devices: VerticalLayout {
                    if device.trusted: ListRow {
                        icon: Icons.platform(device.platform);
                        title: device.name;
                        description: device.group-compatible
                            ? @tr("The device has selected this group too")
                            : @tr("The device must join and select this group");
                        Switch {
                            checked: device.in-group;
                            y: (parent.height - self.height) / 2;
                            toggled(on) => { App.group-member(App.active-group-id, device.id, on); }
                        }
                    }
                }
                HDivider { }
                Text {
                    text: @tr("Only paired devices can be members. Pair a device on the Devices page to add it here.");
                    color: Theme.c.on-surface-variant;
                    font-size: Theme.body-small;
                    wrap: word-wrap;
                }
            }
            if App.active-group-id != App.default-group-id: HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("Delete group…");
                    icon: Icons.delete;
                    kind: ButtonKind.danger-outlined;
                    clicked => { App.dialog = DialogKind.delete-group; }
                }
            }
        }
    }
}
