// SPDX-License-Identifier: GPL-3.0-or-later
// Desktop shell: sidebar navigation, page toolbar, content, status bar and modal dialogs.
// Layout and tokens follow docs/ui-design.md; keyboard shortcuts are handled at the root.
import { Theme, LavaColors } from "theme.slint";
import { App, DeviceRow, GroupRow, Page, DialogKind } from "app.slint";
import { Icons } from "components/icons.slint";
import { Interactive, Button, ButtonKind, IconButton, TextField, VDivider, HDivider } from "components/controls.slint";
import { Dialog } from "components/surfaces.slint";
import { DevicesPage } from "pages/devices.slint";
import { GroupsPage } from "pages/groups.slint";
import { SettingsPage } from "pages/settings.slint";

export { Theme, LavaColors, App, DeviceRow, GroupRow, Page, DialogKind }

component NavItem inherits Interactive {
    in property <image> icon;
    in property <string> label;
    in property <string> shortcut;
    in property <bool> selected;
    in property <bool> compact;

    height: 44px;
    radius: Theme.radius-lg;
    background: selected ? Theme.c.secondary-container : transparent;
    accessible-label: label;
    accessible-item-selected: selected;

    HorizontalLayout {
        padding-left: root.compact ? 0px : Theme.space-lg;
        padding-right: root.compact ? 0px : Theme.space-md;
        alignment: root.compact ? LayoutAlignment.center : LayoutAlignment.stretch;
        spacing: Theme.space-md;
        Image {
            source: root.icon;
            colorize: root.selected ? Theme.c.on-secondary-container : Theme.c.on-surface-variant;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
        }
        if !root.compact: Text {
            text: root.label;
            color: root.selected ? Theme.c.on-secondary-container : Theme.c.on-surface;
            font-size: Theme.label-large;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if !root.compact && root.shortcut != "": Text {
            text: root.shortcut;
            color: Theme.c.on-surface-variant;
            font-size: Theme.label-small;
            vertical-alignment: center;
        }
    }

    if root.compact: Tooltip {
        Rectangle {
            background: Theme.c.inverse-surface;
            border-radius: Theme.radius-xs;
            HorizontalLayout {
                padding: Theme.space-sm;
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;
                Text { text: root.label + "  " + root.shortcut; color: Theme.c.inverse-on-surface; font-size: Theme.body-small; }
            }
        }
    }
}

component Sidebar inherits Rectangle {
    in property <bool> compact;
    background: Theme.c.surface-container;

    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-xs;

        if !root.compact: Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.c.surface-container-high;
            VerticalLayout {
                padding: Theme.space-md;
                spacing: 2px;
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    Image {
                        source: Icons.computer;
                        colorize: Theme.c.primary;
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: App.local-name;
                        color: Theme.c.on-surface;
                        font-size: Theme.title-small;
                        font-weight: 600;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    text: App.identity;
                    color: Theme.c.on-surface-variant;
                    font-size: Theme.label-small;
                    font-family: "monospace";
                    overflow: elide;
                }
            }
        }
        if !root.compact: Rectangle { height: Theme.space-sm; }

        NavItem {
            icon: Icons.devices;
            label: @tr("Devices");
            shortcut: "Ctrl+1";
            compact: root.compact;
            selected: App.page == Page.devices;
            clicked => { App.page = Page.devices; App.page-changed(); }
        }
        NavItem {
            icon: Icons.workspaces;
            label: @tr("Clipboard groups");
            shortcut: "Ctrl+2";
            compact: root.compact;
            selected: App.page == Page.groups;
            clicked => { App.page = Page.groups; App.page-changed(); }
        }
        NavItem {
            icon: Icons.settings;
            label: @tr("Settings");
            shortcut: "Ctrl+3";
            compact: root.compact;
            selected: App.page == Page.settings;
            clicked => { App.page = Page.settings; App.page-changed(); }
        }

        Rectangle { vertical-stretch: 1; }

        NavItem {
            icon: App.paused ? Icons.play-arrow : Icons.pause;
            label: App.paused ? @tr("Resume sync") : @tr("Pause sync");
            compact: root.compact;
            clicked => { App.toggle-pause(); }
        }
    }
}

component StatusBar inherits Rectangle {
    height: 28px;
    background: Theme.c.surface-container-low;
    HDivider { y: 0; width: 100%; }
    HorizontalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        spacing: Theme.space-sm;
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: App.paused ? Theme.c.outline : App.connected-count > 0 ? Theme.c.primary : Theme.c.tertiary;
        }
        Text {
            text: App.paused ? @tr("Paused") : App.connected-count > 0
                ? @tr("Syncing with {n} device" | "Syncing with {n} devices" % App.connected-count)
                : @tr("No connected devices");
            color: Theme.c.on-surface-variant;
            font-size: Theme.label-medium;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: App.status-text(App.status-kind, App.status-detail);
            color: App.status-kind == 4 ? Theme.c.error : Theme.c.on-surface-variant;
            font-size: Theme.label-medium;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component MainWindow inherits Window {
    title: "Lava Connect";
    icon: @image-url("../../../assets/icon.png");
    min-width: 640px;
    min-height: 480px;
    background: Theme.c.surface;
    default-font-size: Theme.body-medium;

    property <bool> compact: root.width < 760px;
    property <int> settings-category;

    public function close-dialog() {
        App.dialog = DialogKind.none;
        keys.focus();
    }

    public function confirm-dialog() {
        if (App.dialog == DialogKind.confirm-pairing) {
            App.device-action("confirm", App.dialog-device.id, App.dialog-device.code);
        } else if (App.dialog == DialogKind.unpair) {
            App.device-action("unpair", App.dialog-device.id, "");
        } else if (App.dialog == DialogKind.delete-group) {
            App.group-action("delete", "", App.active-group-id);
        } else if (App.dialog == DialogKind.create-group) {
            if (group-name.text == "") { return; }
            App.group-action("create", group-name.text, "");
            group-name.text = "";
        } else if (App.dialog == DialogKind.join-group) {
            if (join-code.text == "" || join-name.text == "") { return; }
            App.group-action("join", join-name.text, join-code.text);
            join-code.text = "";
        } else if (App.dialog == DialogKind.send-text) {
            if (send-input.text == "") { return; }
            App.send-text(send-input.text);
            send-input.text = "";
        }
        close-dialog();
    }

    public function open-dialog(kind: DialogKind) {
        App.dialog = kind;
        if (kind == DialogKind.create-group) { group-name.focus(); }
        if (kind == DialogKind.join-group) { join-code.focus(); }
        if (kind == DialogKind.send-text) { send-input.focus(); }
    }

    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (App.dialog != DialogKind.none) {
                if (event.text == Key.Escape) {
                    close-dialog();
                    return accept;
                }
                if (event.text == Key.Return) {
                    confirm-dialog();
                    return accept;
                }
                return reject;
            }
            if (event.modifiers.control) {
                if (event.text == "1") { App.page = Page.devices; App.page-changed(); return accept; }
                if (event.text == "2") { App.page = Page.groups; App.page-changed(); return accept; }
                if (event.text == "3") { App.page = Page.settings; App.page-changed(); return accept; }
                if (event.text == "q" || event.text == "Q") { App.quit(); return accept; }
                if (event.text == "w" || event.text == "W") { App.hide-window(); return accept; }
                if (event.modifiers.shift && (event.text == "v" || event.text == "V")) {
                    App.send-clipboard();
                    return accept;
                }
                if (event.text == "t" || event.text == "T") { open-dialog(DialogKind.send-text); return accept; }
                if (event.text == "f" || event.text == "F") {
                    App.page = Page.devices;
                    filter.focus();
                    return accept;
                }
                return reject;
            }
            if (App.page == Page.devices) {
                if (event.text == Key.UpArrow) { App.move-selection(-1); return accept; }
                if (event.text == Key.DownArrow) { App.move-selection(1); return accept; }
                if (event.text == Key.Return) { App.activate-selected(); return accept; }
            }
            if (event.text == Key.Escape) {
                if (filter.has-focus || App.filter-text != "") {
                    App.filter-text = "";
                    filter.text = "";
                    App.filter-changed("");
                    self.focus();
                    return accept;
                }
                App.select-device("");
                return accept;
            }
            reject
        }

        // Explicit geometry (not a layout) so the width-dependent sidebar does not feed back
        // into the window's own size constraints.
        sidebar := Sidebar {
            x: 0;
            y: 0;
            width: root.compact ? 76px : 248px;
            height: parent.height;
            compact: root.compact;
        }
        VDivider {
            x: sidebar.width;
            y: 0;
            height: parent.height;
        }
        Rectangle {
            x: sidebar.width + 1px;
            y: 0;
            width: parent.width - self.x;
            height: parent.height;
            VerticalLayout {
                // Page toolbar: title and the page's primary actions.
                HorizontalLayout {
                    padding-left: Theme.space-xl;
                    padding-right: Theme.space-lg;
                    padding-top: Theme.space-md;
                    padding-bottom: Theme.space-md;
                    spacing: Theme.space-sm;
                    height: 64px;
                    Text {
                        text: App.page == Page.devices ? @tr("Devices") : App.page == Page.groups ? @tr("Clipboard groups") : @tr("Settings");
                        color: Theme.c.on-surface;
                        font-size: Theme.title-large;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    filter := TextField {
                        visible: App.page == Page.devices;
                        width: App.page == Page.devices ? (root.compact ? 160px : 220px) : 0px;
                        placeholder: root.compact ? @tr("Filter devices") : @tr("Filter devices (Ctrl+F)");
                        icon: Icons.search;
                        edited(text) => {
                            App.filter-text = text;
                            App.filter-changed(text);
                        }
                    }
                    if App.page == Page.devices: Button {
                        text: root.compact ? "" : @tr("Send text");
                        accessible-label: @tr("Send text");
                        icon: Icons.send;
                        kind: ButtonKind.outlined;
                        clicked => { open-dialog(DialogKind.send-text); }
                    }
                    if App.page == Page.devices: Button {
                        text: @tr("Send clipboard");
                        icon: Icons.content-paste;
                        enabled: !App.paused;
                        clicked => { App.send-clipboard(); }
                    }
                    if App.page == Page.groups: Button {
                        text: @tr("Join group");
                        icon: Icons.group-add;
                        kind: ButtonKind.outlined;
                        clicked => { open-dialog(DialogKind.join-group); }
                    }
                    if App.page == Page.groups: Button {
                        text: @tr("Create group");
                        icon: Icons.add;
                        kind: ButtonKind.tonal;
                        clicked => { open-dialog(DialogKind.create-group); }
                    }
                }
                HDivider { }
                Rectangle {
                    vertical-stretch: 1;
                    if App.page == Page.devices: DevicesPage {
                        list-width: root.compact ? 260px : 340px;
                    }
                    if App.page == Page.groups: GroupsPage {
                        list-width: root.compact ? 220px : 280px;
                    }
                    if App.page == Page.settings: SettingsPage {
                        category <=> root.settings-category;
                    }
                }
                StatusBar { }
            }
        }

        // Dialogs. Text inputs live outside conditionals so the shell can focus and read them.
        Dialog {
            visible: App.dialog == DialogKind.confirm-pairing;
            title: @tr("Confirm pairing");
            confirm-label: @tr("Confirm");
            dismiss-label: @tr("Cancel");
            confirm => { confirm-dialog(); }
            dismiss => { close-dialog(); }
            Text {
                text: @tr("Only confirm if both devices show the same code and this device ID.");
                color: Theme.c.on-surface;
                wrap: word-wrap;
            }
            Text {
                text: App.dialog-device.code;
                color: Theme.c.primary;
                font-size: Theme.display-small;
                font-family: "monospace";
            }
            Text { text: App.dialog-device.name; color: Theme.c.on-surface; font-size: Theme.title-small; font-weight: 600; }
            Text {
                text: App.dialog-device.id;
                color: Theme.c.on-surface-variant;
                font-size: Theme.body-small;
                font-family: "monospace";
                wrap: char-wrap;
            }
        }
        Dialog {
            visible: App.dialog == DialogKind.unpair;
            title: @tr("Unpair {}?", App.dialog-device.name);
            confirm-label: @tr("Unpair");
            dismiss-label: @tr("Cancel");
            destructive: true;
            confirm => { confirm-dialog(); }
            dismiss => { close-dialog(); }
            Text {
                text: @tr("The device must be paired again before it can sync.");
                color: Theme.c.on-surface;
                wrap: word-wrap;
            }
        }
        Dialog {
            visible: App.dialog == DialogKind.delete-group;
            title: @tr("Delete {}?", App.active-group-name);
            confirm-label: @tr("Delete group");
            dismiss-label: @tr("Cancel");
            destructive: true;
            confirm => { confirm-dialog(); }
            dismiss => { close-dialog(); }
            Text {
                text: @tr("Syncing in this group stops and this device returns to the Default group.");
                color: Theme.c.on-surface;
                wrap: word-wrap;
            }
        }
        Dialog {
            visible: App.dialog == DialogKind.create-group;
            title: @tr("Create group");
            confirm-label: @tr("Create group");
            dismiss-label: @tr("Cancel");
            confirm-enabled: group-name.text != "";
            confirm => { confirm-dialog(); }
            dismiss => { close-dialog(); }
            group-name := TextField { placeholder: @tr("Group name"); }
        }
        Dialog {
            visible: App.dialog == DialogKind.join-group;
            title: @tr("Join group");
            confirm-label: @tr("Join group");
            dismiss-label: @tr("Cancel");
            confirm-enabled: join-code.text != "" && join-name.text != "";
            confirm => { confirm-dialog(); }
            dismiss => { close-dialog(); }
            join-code := TextField { placeholder: @tr("Group code"); monospace: true; }
            join-name := TextField { placeholder: @tr("Name on this device"); }
            Text {
                text: @tr("Group codes identify groups. They are not passwords and do not pair or authorize devices.");
                color: Theme.c.on-surface-variant;
                font-size: Theme.body-small;
                wrap: word-wrap;
            }
        }
        Dialog {
            visible: App.dialog == DialogKind.send-text;
            title: @tr("Send text");
            confirm-label: @tr("Send");
            dismiss-label: @tr("Cancel");
            confirm-enabled: send-input.text != "";
            confirm => { confirm-dialog(); }
            dismiss => { close-dialog(); }
            send-input := TextField { placeholder: @tr("Text to send"); }
        }
    }
}
