// SPDX-License-Identifier: GPL-3.0-or-later
// Desktop counterparts of android/.../ui/design/component. Interaction follows
// LavaInteractionSurface: no ripple, an 8%/12% state layer for hover/press, and a
// 2px primary focus ring that only appears for keyboard focus (focus-on-click: false).
import { Theme } from "../theme.slint";

/// State layer + focus ring + pointer handling shared by every clickable control.
export component Interactive inherits Rectangle {
    in property <bool> enabled: true;
    in property <color> layer-color: Theme.c.on-surface;
    in property <length> radius: Theme.radius-sm;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    out property <bool> keyboard-focus: focus.has-focus;
    callback clicked();
    callback right-clicked(Point);

    border-radius: root.radius;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (enabled) { clicked(); } }

    layer := Rectangle {
        border-radius: root.radius;
        background: root.layer-color;
        opacity: !root.enabled ? 0 : touch.pressed ? Theme.pressed-alpha : touch.has-hover ? Theme.hover-alpha : 0;
        animate opacity { duration: Theme.micro; }
    }

    @children

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.right-clicked({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        border-radius: root.radius;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.c.primary;
    }
}

export enum ButtonKind { filled, tonal, outlined, text, danger, danger-outlined }

export component Button inherits Interactive {
    in property <string> text;
    in property <image> icon;
    in property <ButtonKind> kind: ButtonKind.filled;

    property <color> fg: root.kind == ButtonKind.filled ? Theme.c.on-primary
        : root.kind == ButtonKind.tonal ? Theme.c.on-secondary-container
        : root.kind == ButtonKind.danger ? Theme.c.on-error
        : root.kind == ButtonKind.danger-outlined ? Theme.c.error
        : Theme.c.primary;

    height: Theme.control-height;
    min-width: layout.min-width;
    radius: Theme.radius-sm;
    layer-color: root.fg;
    accessible-label: root.text;
    opacity: root.enabled ? 1 : 0.38;
    background: root.kind == ButtonKind.filled ? Theme.c.primary
        : root.kind == ButtonKind.tonal ? Theme.c.secondary-container
        : root.kind == ButtonKind.danger ? Theme.c.error
        : transparent;
    border-width: root.kind == ButtonKind.outlined || root.kind == ButtonKind.danger-outlined ? 1px : 0px;
    border-color: root.kind == ButtonKind.danger-outlined ? Theme.c.error : Theme.c.outline-variant;

    layout := HorizontalLayout {
        padding-left: kind == ButtonKind.text ? 12px : 16px;
        padding-right: self.padding-left;
        spacing: Theme.space-sm;
        alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: root.fg;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.label-large;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

export component IconButton inherits Interactive {
    in property <image> icon;
    in property <string> label;
    in property <color> tint: Theme.c.on-surface-variant;
    in property <bool> selected;
    in property <length> size: Theme.control-height;

    width: root.size;
    height: root.size;
    radius: Theme.radius-sm;
    accessible-label: root.label;
    opacity: root.enabled ? 1 : 0.38;
    background: root.selected ? Theme.c.secondary-container : transparent;
    layer-color: root.tint;

    Image {
        source: root.icon;
        colorize: root.selected ? Theme.c.on-secondary-container : root.tint;
        width: 20px;
        height: 20px;
    }

    if root.label != "": Tooltip {
        Rectangle {
            background: Theme.c.inverse-surface;
            border-radius: Theme.radius-xs;
            HorizontalLayout {
                padding: Theme.space-sm;
                padding-top: Theme.space-xs;
                padding-bottom: Theme.space-xs;
                Text { text: root.label; color: Theme.c.inverse-on-surface; font-size: Theme.body-small; }
            }
        }
    }
}

/// M3 switch, 44x24 on desktop.
export component Switch inherits Interactive {
    in-out property <bool> checked;
    callback toggled(bool);

    width: 44px;
    height: 24px;
    radius: 12px;
    layer-color: Theme.c.primary;
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.checked;
    opacity: root.enabled ? 1 : 0.38;
    background: root.checked ? Theme.c.primary : Theme.c.surface-container-highest;
    border-width: root.checked ? 0px : 2px;
    border-color: Theme.c.outline;
    animate background { duration: Theme.micro; }
    clicked => {
        checked = !checked;
        toggled(checked);
    }

    Rectangle {
        property <length> d: root.checked ? 16px : 12px;
        width: d;
        height: d;
        border-radius: d / 2;
        x: root.checked ? root.width - d - 4px : 6px;
        background: root.checked ? Theme.c.on-primary : Theme.c.outline;
        animate x, width, height { duration: Theme.micro; }
    }
}

export component TextField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <image> icon;
    in property <bool> monospace;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);

    forward-focus: input;
    height: Theme.control-height;
    border-radius: Theme.radius-xs;
    background: Theme.c.surface-container-lowest;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.c.primary : Theme.c.outline-variant;
    accessible-role: text-input;
    accessible-label: placeholder;

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-sm;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: Theme.c.on-surface-variant;
            width: 18px;
            y: (parent.height - 18px) / 2;
            height: 18px;
        }
        Rectangle {
            input := TextInput {
                width: 100%;
                color: Theme.c.on-surface;
                font-size: Theme.body-medium;
                font-family: root.monospace ? "monospace" : "";
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.c.primary-container;
                selection-foreground-color: Theme.c.on-primary-container;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            if input.text == "": Text {
                width: 100%;
                text: root.placeholder;
                color: Theme.c.on-surface-variant;
                font-size: Theme.body-medium;
                vertical-alignment: center;
            }
        }
    }
}

/// LavaSegmentedSelector: outer small shape, 1px outline-variant, selected segment in primary-container.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback changed(int);

    height: Theme.control-height;
    border-radius: Theme.radius-sm;
    background: Theme.c.surface-container-low;
    border-width: 1px;
    border-color: Theme.c.outline-variant;
    accessible-role: tab-list;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[index] in root.options: Interactive {
            radius: Theme.radius-xs;
            background: index == root.current ? Theme.c.primary-container : transparent;
            accessible-role: tab;
            accessible-label: option;
            accessible-item-selected: index == root.current;
            clicked => {
                root.current = index;
                root.changed(index);
            }
            Text {
                text: option;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: Theme.label-large;
                font-weight: index == root.current ? 600 : 400;
                color: index == root.current ? Theme.c.on-primary-container : Theme.c.on-surface;
            }
        }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;

    height: 20px;
    width: label.preferred-width + 2 * Theme.space-sm;
    border-radius: Theme.radius-xs;
    background: root.active ? Theme.c.primary-container : Theme.c.surface-container-highest;

    label := Text {
        text: root.text;
        font-size: Theme.label-medium;
        font-weight: 500;
        color: root.active ? Theme.c.on-primary-container : Theme.c.on-surface-variant;
        vertical-alignment: center;
    }
}

export component HDivider inherits Rectangle {
    height: 1px;
    background: Theme.c.outline-variant;
    opacity: 0.55;
}

export component VDivider inherits Rectangle {
    width: 1px;
    background: Theme.c.outline-variant;
    opacity: 0.55;
}
